# --- Telegram ---
# From @BotFather. Also run /setprivacy -> Disable so the bot can see group photos.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Optional: comma-separated chat IDs the bot is allowed to work in.
# Leave empty to allow every group the bot is added to.
# Send /id in the group to get its chat ID.
ALLOWED_CHAT_IDS=

# --- Slip data extraction ---
# openai | gemini | auto   (auto = OpenAI until its credit runs out, then Gemini)
PROVIDER=openai

OPENAI_API_KEY=sk-proj-your-key
# gpt-4o-mini (default, cheap) | gpt-4o (more accurate, ~15x cost)
EXTRACTION_MODEL=gpt-4o-mini

# Only needed for PROVIDER=gemini or auto. Key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Max extraction calls in flight at once (tune for your rate limits / burst size)
MAX_CONCURRENCY=5

# Shown when the slip doesn't state the mode. Blank = hide the row when unknown.
DEFAULT_TRANSFER_MODE=IMPS

# --- Company branding (shown on every generated confirmation) ---
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_TAGLINE=Payment Confirmation
COMPANY_WEBSITE=www.yourcompany.com
COMPANY_SUPPORT=support@yourcompany.com
# Hex colours for the header band / accents
BRAND_PRIMARY=#2E90D8
BRAND_ACCENT=#3ED598
# Optional logo file (PNG with transparency looks best), path relative to project root
COMPANY_LOGO=assets/logo.png
